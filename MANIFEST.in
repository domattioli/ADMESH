# Source distribution contents: explicit includes only.
include README.md
include LICENSE
include CHANGELOG.md
include pyproject.toml

recursive-include src/admesh *.py

# C++ extension sources: setup.py compiles these when pybind11 and Eigen3 are present.
recursive-include src/admesh/_cpp *.cpp *.h *.hpp

# setuptools adds tests/test*.py by default; keep tests out of the sdist.
prune tests

global-exclude __pycache__
global-exclude *.pyc
global-exclude .DS_Store


# >>> release-ignore:begin (generated by DomI release-integrity — do not edit inside; edit .release-ignore.toml + regenerate)
prune .claude
prune .claude-plugin
prune .introspect
prune .githooks
prune .specify
prune .planning
global-exclude .domi-pin
global-exclude .zenodoignore
global-exclude .release-ignore.toml
global-exclude CLAUDE.md
global-exclude AGENTS.md
global-exclude CONTEXT.md
global-exclude AGENT.md
global-exclude CLAUDE.local.md
global-exclude GEMINI.md
prune .agents
prune .codex
prune .gemini
prune .cursor
global-exclude .cursorrules
global-exclude .windsurfrules
global-exclude .aider*
global-exclude .mcp.json
prune .projectmem
exclude .github/copilot-instructions.md
global-exclude claude_routine_instructions.md
global-exclude instructions_on_start.sh
prune scripts/hooks
prune docs/sessions
prune docs/introspections
prune specs
global-exclude *introspect*.yml
prune .github
prune tests
global-exclude .gitattributes
global-exclude .gitignore
exclude docs/HOOKS-AUDIT.md
exclude docs/persistence_journal.md
exclude docs/upstream/DOMI_SYNC_FROM_GH_DEPENDENCY.md
prune docs/governance
prune zenodo/patches
# <<< release-ignore:end
